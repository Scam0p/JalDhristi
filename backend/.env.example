# ==============================================================================
# JalDrishti Local Telemetry Pipeline Configuration
# ==============================================================================
# ALL SETTINGS BELOW ARE AUTO-CONFIGURED WITH SENSIBLE DEFAULTS.
# You do NOT need to create or edit a .env file when switching Wi-Fi / hotspots!
# 
# The backend automatically detects your primary LAN IP and connects to the
# local MQTT broker via loopback (127.0.0.1:1883).

# Optional overrides (Leave commented out for automatic operation):
# LAPTOP_IP=              # Auto-detected via 'npm run ip'
# MQTT_HOST=127.0.0.1     # Defaults to 127.0.0.1 for local backend
# MQTT_PORT=1883
# MQTT_TOPIC=jaldrishti/node01/vibration
# MQTT_BROKER_URL=mqtt://127.0.0.1:1883

# Backend REST API Server Settings
PORT=5001
HOST=0.0.0.0

# Telemetry Freshness Timeout (milliseconds)
# If no new telemetry is received within this window, frontend status changes to STALE
FRESHNESS_TIMEOUT_MS=10000

# Consistent acceleration & vibration units
UNIT=m/s²
